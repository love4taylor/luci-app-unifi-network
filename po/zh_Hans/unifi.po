msgid "AP & Clients"
msgstr "AP 与客户端"

msgid "API key"
msgstr "API 密钥"

msgid "Access point"
msgstr "接入点"

msgid "Access point status and connected Wi-Fi clients from the UniFi Network Integration API."
msgstr "通过 UniFi Network Integration API 查看 AP 状态和在线 Wi-Fi 客户端。"

msgid "Access points"
msgstr "AP 列表"

msgid "Broadcast"
msgstr "广播"

msgid "CPU usage"
msgstr "CPU 使用率"

msgid "Action"
msgstr "操作"

msgid "Client"
msgstr "客户端"

msgid "Check for updates"
msgstr "检查设备更新"

msgid "Connect to the UniFi Network Integration API. Create an API key in the UniFi console and enter it here."
msgstr "连接 UniFi Network Integration API。请在 UniFi 控制台创建 API 密钥并填入此处。"

msgid "Connected since"
msgstr "连接时间"

msgid "Connection"
msgstr "连接设置"

msgid "Connected clients"
msgstr "已连接客户端"

msgid "Console URL"
msgstr "控制台地址"

msgid "Keep enabled when the console certificate is trusted by OpenWrt."
msgstr "当 OpenWrt 信任控制台证书时，请保持启用。"

msgid "TLS public key pin"
msgstr "TLS 公钥指纹"

msgid "Enter a SHA-256 public key pin in sha256//...= format"
msgstr "请输入 sha256//...= 格式的 SHA-256 公钥指纹"

msgid "Required when certificate verification is disabled. A certificate change may require updating this pin."
msgstr "关闭证书验证时必须填写；证书变更后可能需要更新此指纹。"

msgid "Disabled"
msgstr "已停用"

msgid "Device"
msgstr "设备"

msgid "Device / port"
msgstr "设备 / 端口"

msgid "Enabled"
msgstr "已启用"

msgid "Encryption"
msgstr "加密方式"

msgid "Enter an HTTPS console URL without a path"
msgstr "请输入不含路径的 HTTPS 控制台地址"

msgid "Firmware"
msgstr "固件版本"

msgid "Firmware update check requested; availability will refresh shortly."
msgstr "已请求检查设备固件更新，更新状态稍后会自动刷新。"

msgid "Firmware update requested for %s"
msgstr "已请求升级 %s 的固件"

msgid "Frequency bands"
msgstr "频段"

msgid "Hidden"
msgstr "隐藏"

msgid "Hide password"
msgstr "隐藏密码"

msgid "Hide QR code"
msgstr "收起二维码"

msgid "First available site"
msgstr "首个可用站点"

msgid "IP address"
msgstr "IP 地址"

msgid "Loading APs and clients…"
msgstr "正在加载 AP 和客户端…"

msgid "Link speed"
msgstr "链路速率"

msgid "Load average (1/5/15 min)"
msgstr "平均负载（1/5/15 分钟）"

msgid "MAC address"
msgstr "MAC 地址"

msgid "Memory usage"
msgstr "内存使用率"

msgid "Model"
msgstr "型号"

msgid "Name"
msgstr "名称"

msgid "No UniFi sites found"
msgstr "未发现 UniFi 站点"

msgid "No adopted access points found"
msgstr "未发现已接入的 AP"

msgid "No connected Wi-Fi clients found"
msgstr "当前没有在线的 Wi-Fi 客户端"

msgid "No connected wired clients found"
msgstr "当前没有在线的有线客户端"

msgid "No update available"
msgstr "暂无可用更新"

msgid "No password"
msgstr "无密码"

msgid "No Wi-Fi networks found"
msgstr "未发现 Wi-Fi 网络"

msgid "Negotiated rate"
msgstr "协商速率"

msgid "Offline"
msgstr "离线"

msgid "Online"
msgstr "在线"

msgid "Online time"
msgstr "在线时长"

msgid "Open"
msgstr "开放"

msgid "Other devices"
msgstr "其他设备"

msgid "Port %s"
msgstr "端口 %s"

msgid "Refresh"
msgstr "刷新"

msgid "Reconnect"
msgstr "重新连接"

msgid "Reconnect requested for %s"
msgstr "已请求让 %s 重新连接"

msgid "Reconnect Wi-Fi client %s? The client will briefly disconnect."
msgstr "让 Wi-Fi 客户端 %s 重新连接？客户端会短暂断线。"

msgid "Restart"
msgstr "重启"

msgid "Restart AP %s? Connected clients will be disconnected."
msgstr "重启 AP %s？已连接的客户端将会断开。"

msgid "Restart device %s? Connected clients will be disconnected."
msgstr "重启设备 %s？已连接的客户端将会断开。"

msgid "Restart requested for %s"
msgstr "已请求重启 %s"

msgid "Save the connection settings, then reopen this page to choose a site."
msgstr "先保存连接设置，再重新打开本页选择站点。"

msgid "Settings"
msgstr "设置"

msgid "Show password"
msgstr "显示密码"

msgid "Show QR code"
msgstr "显示二维码"

msgid "Signal"
msgstr "信号强度"

msgid "SSID visibility"
msgstr "SSID 可见性"

msgid "Switch"
msgstr "交换机"

msgid "Switches"
msgstr "交换机"

msgid "Site"
msgstr "站点"

msgid "Status"
msgstr "状态"

msgid "Unexpected response from UniFi Network"
msgstr "UniFi Network 返回了意外的响应"

msgid "Extended UniFi data unavailable: "
msgstr "无法获取 UniFi 扩展数据："

msgid "UniFi API request failed: "
msgstr "UniFi API 请求失败："

msgid "UniFi Network"
msgstr "UniFi Network"

msgid "Update available"
msgstr "有可用更新"

msgid "Update firmware"
msgstr "更新固件"

msgid "Update firmware on %s? The device and its clients will be disconnected during the upgrade."
msgstr "更新 %s 的固件？升级期间设备及其客户端会断线。"

msgid "Updated: "
msgstr "更新于："

msgid "Updating"
msgstr "正在更新"

msgid "Uptime"
msgstr "运行时间"

msgid "Verify TLS certificate"
msgstr "验证 TLS 证书"

msgid "UniFi API returned too many records"
msgstr "UniFi API 返回的记录过多"

msgid "Wi-Fi clients"
msgstr "Wi-Fi 客户端"

msgid "Wi-Fi networks"
msgstr "Wi-Fi 网络"

msgid "Wi-Fi QR code"
msgstr "Wi-Fi 二维码"

msgid "Wi-Fi standard"
msgstr "Wi-Fi 标准"

msgid "Wired clients"
msgstr "有线客户端"

msgid "SNI hostname"
msgstr "SNI 域名"

msgid "Enter a valid SNI hostname without a scheme, port or path"
msgstr "请输入有效的 SNI 域名，不包含协议、端口或路径"

msgid "Optional. Connect to the console URL address using this hostname for TLS SNI, certificate verification and the HTTP Host header. Leave empty to use the URL hostname."
msgstr "可选。仍连接控制台地址，使用此域名进行 TLS SNI、证书验证及 HTTP Host 匹配；留空则使用控制台地址中的主机名。"

msgid "Cannot connect to the UniFi console. It may be powered off or unreachable; check its address, port and network connection."
msgstr "无法连接 UniFi 控制台，可能已关机或网络不可达；请检查地址、端口及网络连接。"

msgid "Cannot resolve the UniFi console address. Check the hostname and DNS settings."
msgstr "无法解析 UniFi 控制台地址，请检查主机名及 DNS 设置。"

msgid "The UniFi console request timed out. Check whether the console is online and reachable."
msgstr "UniFi 控制台请求超时，请检查控制台是否在线及网络是否可达。"

msgid "TLS handshake with the UniFi console failed. Check the HTTPS port and SNI hostname."
msgstr "与 UniFi 控制台的 TLS 握手失败，请检查 HTTPS 端口及 SNI 域名。"

msgid "UniFi console certificate verification failed. Check the certificate, SNI hostname and router clock."
msgstr "UniFi 控制台证书验证失败，请检查证书、SNI 域名及路由器时间。"

msgid "The UniFi console TLS public key does not match the configured pin. Verify the certificate before updating the pin."
msgstr "UniFi 控制台的 TLS 公钥与配置的指纹不匹配，请核对证书后再更新指纹。"

msgid "The UniFi console returned an empty response. It may be restarting or unavailable."
msgstr "UniFi 控制台返回了空响应，可能正在重启或服务不可用。"

msgid "The UniFi console returned an invalid response. Check the console URL and reverse proxy settings."
msgstr "UniFi 控制台返回了无效响应，请检查控制台地址及反向代理配置。"

msgid "The UniFi console connection was interrupted. Check the console and network connection."
msgstr "与 UniFi 控制台的连接中断，请检查控制台及网络连接。"

msgid "Configure a valid UniFi API key"
msgstr "请配置有效的 UniFi API 密钥"

msgid "TLS verification requires a trusted certificate or a public key pin"
msgstr "TLS 验证需要可信证书或已配置的公钥指纹"

msgid "UniFi API authentication failed. Check the API key and its permissions."
msgstr "UniFi API 认证失败，请检查 API 密钥及其权限。"

msgid "UniFi API endpoint not found. Check the console URL and Network Integration API availability."
msgstr "未找到 UniFi API 接口，请检查控制台地址及 Network Integration API 是否可用。"

msgid "The UniFi console is receiving too many requests. Try again later."
msgstr "UniFi 控制台收到的请求过多，请稍后重试。"

msgid "The UniFi console or reverse proxy is unavailable (HTTP %s). Try again when the service is running."
msgstr "UniFi 控制台或反向代理服务不可用（HTTP %s），请等待服务启动后重试。"

msgid "The UniFi console returned HTTP %s. Check the console and reverse proxy settings."
msgstr "UniFi 控制台返回 HTTP %s，请检查控制台及反向代理配置。"

msgid "UniFi request failed. Check the connection settings and try again."
msgstr "UniFi 请求失败，请检查连接设置后重试。"

#!/bin/sh

set -e
. /usr/libexec/unifi-network/unifi-common.sh
[ "$#" -eq 3 ] && unifi_uuid "$2" || exit 1
case "$1" in password|qr) ;; *) exit 1 ;; esac
case "$3" in
	????????????????????????) case "$3" in *[!0-9a-fA-F]*) exit 1 ;; esac ;;
	*) exit 1 ;;
esac
unifi_config
site="$(unifi_legacy_site "$2")"
case "$site" in ''|*[!a-zA-Z0-9_-]*) exit 1 ;; esac
response="$(unifi_legacy_request "api/s/$site/rest/wlanconf")"
config="$(printf '%s' "$response" | jq -ce --arg id "$3" '.data[] | select(._id == $id)')"

if [ "$1" = password ]; then
	printf '%s' "$config" | jq -c '{password: (.x_passphrase // "")}'
	exit 0
fi

wifi_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/;/\\;/g; s/:/\\:/g; s/,/\\,/g; s/"/\\"/g'
}

ssid="$(printf '%s' "$config" | jq -r '.name')"
password="$(printf '%s' "$config" | jq -r '.x_passphrase // ""')"
security="$(printf '%s' "$config" | jq -r '.security')"
hidden="$(printf '%s' "$config" | jq -r '.hide_ssid')"
case "$security" in
	wpapsk) qr_type=WPA ;;
	open) qr_type=nopass ;;
	*) exit 1 ;;
esac
case "$hidden" in true) qr_hidden=true ;; *) qr_hidden=false ;; esac
printf 'WIFI:T:%s;S:%s;P:%s;H:%s;;' "$qr_type" "$(wifi_escape "$ssid")" \
	"$(wifi_escape "$password")" "$qr_hidden" | qrencode --type SVG --output -

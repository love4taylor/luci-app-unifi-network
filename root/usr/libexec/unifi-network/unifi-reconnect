#!/bin/sh

set -e
. /usr/libexec/unifi-network/unifi-common.sh
[ "$#" -eq 2 ] && unifi_uuid "$1" && unifi_mac "$2" || exit 1
unifi_config
site="$(unifi_legacy_site "$1")"
case "$site" in ''|*[!a-zA-Z0-9_-]*) exit 1 ;; esac
mac="$(printf '%s' "$2" | tr 'A-F' 'a-f')"

clients="$(unifi_legacy_request "api/s/$site/stat/sta")"
printf '%s' "$clients" | \
	jq -e --arg mac "$mac" '[.data[] | select(.is_wired == false and (.mac | ascii_downcase) == $mac)] | length > 0' >/dev/null

response="$(unifi_legacy_post "api/s/$site/cmd/stamgr" "$(jq -nc --arg mac "$mac" '{cmd: "kick-sta", mac: $mac}')")"
printf '%s' "$response" | jq -e '.meta.rc == "ok"' >/dev/null
printf '{"ok":true}\n'
